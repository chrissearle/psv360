{
  "name": "psv360",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "generate:config": "node --experimental-strip-types scripts/generate-config.ts",
    "format": "prettier --write --list-different .",
    "prepare": "husky",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nuxt/scripts": "1.3.12",
    "@nuxt/ui": "4.12.0",
    "@photo-sphere-viewer/core": "5.15.1",
    "@photo-sphere-viewer/equirectangular-tiles-adapter": "5.15.1",
    "@photo-sphere-viewer/markers-plugin": "5.15.1",
    "@photo-sphere-viewer/virtual-tour-plugin": "5.15.1",
    "@prometheus-io/client": "0.16.1",
    "nuxt": "4.6.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "1.2.3",
    "@nuxt/eslint": "1.17.0",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": "pnpm lint:fix",
    "*.{md,json,css,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
